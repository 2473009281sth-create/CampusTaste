flowchart TD
    Frontend["React frontend"]
    API["FastAPI"]
    DB["PostgreSQL"]
    Cache["Redis"]
    Broker["RabbitMQ"]
    Worker["Celery Worker"]
    Storage["MinIO"]
    Beat["Celery Beat"]

    Frontend -->|HTTP API| API
    API -->|Read and write| DB
