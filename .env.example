# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="CampusTaste"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ / Celery
RABBITMQ_USER=replace-with-local-user
RABBITMQ_PASSWORD=replace-with-local-password
RABBITMQ_URL=amqp://replace-with-local-user:replace-with-local-password@localhost:5672//

# Private MinIO object storage
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
MINIO_SECURE=False
MINIO_BUCKET=campustaste-images
